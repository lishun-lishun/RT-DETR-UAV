                  640
                ]
              },
              {
                "type": "ToImageTensor"
              },
              {
                "type": "ConvertDtype"
              }
            ]
          }
        },
        "shuffle": false,
        "batch_size": 16,
        "num_workers": 2,
        "drop_last": false,
        "collate_fn": "default_collate_fn",
        "prefetch_factor": 1,
        "persistent_workers": false
