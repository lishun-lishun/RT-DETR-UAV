    "shared_protocol": {
      "train_dataloader": {
        "type": "DataLoader",
        "dataset": {
          "type": "CocoDetection",
          "img_folder": "../DUT-Anti-UAV/DUT-Anti-UAV/images/train/",
          "ann_file": "../DUT-Anti-UAV/DUT-Anti-UAV/labels/train.json",
          "transforms": {
            "type": "Compose",
            "ops": [
              {
                "type": "RandomPhotometricDistort",
                "p": 0.5
              },
              {
                "type": "RandomZoomOut",
                "fill": 0
              },
              {
                "type": "RandomIoUCrop",
                "p": 0.8
              },
              {
                "type": "SanitizeBoundingBox",
                "min_size": 1
              },
              {
                "type": "RandomHorizontalFlip"
              },
              {
                "type": "Resize",
                "size": [
                  640,
                  640
                ]
              },
              {
                "type": "ToImageTensor"
              },
              {
                "type": "ConvertDtype"
              },
              {
                "type": "SanitizeBoundingBox",
                "min_size": 1
              },
              {
                "type": "ConvertBox",
                "out_fmt": "cxcywh",
                "normalize": true
              }
            ]
          },
          "return_masks": false
        },
        "shuffle": true,
        "batch_size": 16,
        "num_workers": 4,
        "drop_last": true,
        "collate_fn": "default_collate_fn",
        "prefetch_factor": 1,
        "persistent_workers": false
      },
      "val_dataloader": {
        "type": "DataLoader",
        "dataset": {
          "type": "CocoDetection",
          "img_folder": "../DUT-Anti-UAV/DUT-Anti-UAV/images/val/",
          "ann_file": "../DUT-Anti-UAV/DUT-Anti-UAV/labels/val.json",
          "transforms": {
            "type": "Compose",
            "ops": [
              {
                "type": "Resize",
